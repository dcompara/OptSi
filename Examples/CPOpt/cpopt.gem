; SIMION 8.1.3.9: two three-electrode lenses with a grounded aperture.
; Axis = workbench X; PA at origin, scale 1. Physical dimensions in mm.
; Fixed dimensions reconstructed from Fig. 10; not an authors' original GEM.
# local c = dofile('cpopt_config.lua')
# local p = _G.cpopt_geometry or {}
# local r = p.r or c.radius_start
# local h = p.h or c.default_mesh_mm
# local ri = {c.end_radius,r[1],r[2],r[3],c.aperture_radius,r[4],r[5],r[6],c.end_radius}
pa_define($(math.ceil(c.domain_x/h)+1), $(math.ceil(c.domain_r/h)+1), 1, cylindrical,, electrostatic,, $(h), $(h), $(h),, surface=fractional)
# for i=1,9 do
# if i~=5 then
e($(i)) { fill { within { box($(c.x_begin[i]),$(ri[i]),$(c.x_end[i]),$(c.outer_radius)) } } }
# end
# end
e(5) {
  fill { within { box($(c.x_begin[5]),$(c.aperture_flange_radius),$(c.x_end[5]),$(c.outer_radius)) } }
  fill { within { box($(c.aperture_web_begin),$(c.aperture_radius),$(c.aperture_web_end),$(c.outer_radius)) } }
}
e(10) { fill { within { box($(c.detector_backing_begin),0,$(c.detector_backing_end),$(c.detector_radius)) } } }
